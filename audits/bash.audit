<check_type:"Unix">

# ============================================================
# CHECK 1: bash1.sh  [EVALUATION]
# ============================================================
<custom_item>
  type          : CMD_EXEC
  description   : "Ensure X Window System is not installed"
  cmd           : "echo  | base64 -d | bash"
  expect        : "Check status ?: ?Compliant"
  timeout       : "300"
  dont_echo_cmd : YES
</custom_item>

# ============================================================
# CHECK 2: bash2.sh  [EVALUATION]
# ============================================================
<custom_item>
  type          : CMD_EXEC
  description   : "Ensure that Trellix HX agent executable version is approved"
  cmd           : "echo  | base64 -d | bash"
  expect        : "Check status ?: ?Compliant"
  timeout       : "300"
  dont_echo_cmd : YES
</custom_item>

# ============================================================
# CHECK 3: bash3.sh  [EVALUATION]
# ============================================================
<custom_item>
  type          : CMD_EXEC
  description   : "Check if logging is configured"
  cmd           : "echo  | base64 -d | bash"
  expect        : "Check status ?: ?Compliant"
  timeout       : "300"
  dont_echo_cmd : YES
</custom_item>

# ============================================================
# CHECK 4: bash4.sh  [EVALUATION]
# ============================================================
<custom_item>
  type          : CMD_EXEC
  description   : "Ensure password reuse is limited"
  cmd           : "echo  | base64 -d | bash"
  expect        : "Check status ?: ?Compliant"
  timeout       : "300"
  dont_echo_cmd : YES
</custom_item>

# ============================================================
# CHECK 5: bash5.sh  [EVALUATION]
# ============================================================
<custom_item>
  type          : CMD_EXEC
  description   : "Ensure that Trellix HX agent executable version is approved"
  cmd           : "echo  | base64 -d | bash"
  expect        : "Check status ?: ?Compliant"
  timeout       : "300"
  dont_echo_cmd : YES
</custom_item>

# ============================================================
# CHECK 6: test_fail.sh  [EVALUATION]
# ============================================================
<custom_item>
  type          : CMD_EXEC
  description   : "TEST - Ensure test marker file exists (expected FAILED)"
  cmd           : "echo  | base64 -d | bash"
  expect        : "Check status ?: ?Compliant"
  timeout       : "300"
  dont_echo_cmd : YES
</custom_item>

# ============================================================
# CHECK 7: test_pass.sh  [EVALUATION]
# ============================================================
<custom_item>
  type          : CMD_EXEC
  description   : "TEST - Ensure /etc/passwd exists (expected PASSED)"
  cmd           : "echo  | base64 -d | bash"
  expect        : "Check status ?: ?Compliant"
  timeout       : "300"
  dont_echo_cmd : YES
</custom_item>

</check_type>
